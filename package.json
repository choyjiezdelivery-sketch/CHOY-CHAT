{
  "name": "choy-chat",
  "version": "1.0.0",
  "description": "CHOY-CHAT — a full-stack social media app (feed, profiles, follows, likes, comments, bookmarks, notifications, direct messages, search).",
  "main": "src/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node src/seed.js",
    "test": "node scripts/check-dom.js && node --test tests/",
    "check:dom": "node scripts/check-dom.js"
  },
  "keywords": [
    "social-media",
    "express",
    "sqlite",
    "choy-chat"
  ],
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.5.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.5.0",
    "ws": "^8.23.0"
  }
}
