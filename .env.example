# Copy to .env and fill in your own values.

# Port the API and web client are served on
PORT=3000

# Node environment: development | production
NODE_ENV=development

# Secret used to sign session tokens (generate a long random string)
SESSION_SECRET=change-me-to-a-long-random-string

# Database connection string (not used yet — the scaffold uses an in-memory store)
# DATABASE_URL=postgres://user:password@localhost:5432/choychat
