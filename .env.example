# CHOY-CHAT — environment variables
#
# Copy to .env for local development:  cp .env.example .env
# On a host, set these in the dashboard's Environment / Secrets panel.
# Only JWT_SECRET is strictly required in production; everything else has a
# working default or is optional.

# ---------------------------------------------------------------- server
# Port the HTTP + WebSocket server listens on. Hosts set this for you.
PORT=3000

# "production" enables the JWT secret guard, HSTS and proxy trust.
NODE_ENV=development

# Trust one reverse-proxy hop so req.ip is the real client IP (rate limiting).
# Set automatically when NODE_ENV=production.
# TRUST_PROXY=true

# ---------------------------------------------------------------- security
# REQUIRED in production. Signs every session token. Must be >= 32 characters.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string

# How long a session token stays valid. Default 7d.
JWT_TTL=7d

# Sign-in attempts allowed per IP per 15 minutes. Default 20.
AUTH_RATE_LIMIT_MAX=20

# Set to "true" to disable the auth rate limiter (tests do this).
# RATE_LIMIT_DISABLED=true

# ---------------------------------------------------------------- database
# SQLite file. Use an absolute path on a mounted volume in production.
DB_PATH=data/choy-chat.db

# ---------------------------------------------------------------- uploads
# Where media is written when the local storage driver is used.
UPLOAD_DIR=uploads

# Largest single upload in bytes. Default 25 MB.
UPLOAD_MAX_BYTES=26214400

# ---------------------------------------------------------------- admin
# Username promoted to admin on boot. Use your own CHOY-CHAT username.
ADMIN_USERNAME=

# Optional 4-8 digit PIN required to open the admin dashboard.
ADMIN_PIN=

# ---------------------------------------------------------------- supabase (optional)
# Only needed to store media in Supabase Storage instead of local disk.
# Dashboard: https://app.supabase.com/project/_/settings/api
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_BUCKET=choy-chat-media

# ---------------------------------------------------------------- github (optional)
# Lets the admin dashboard commit files to the repo.
# Token: https://github.com/settings/tokens  (Contents: Read and write)
GITHUB_TOKEN=
GITHUB_REPO=choyjiezdelivery-sketch/CHOY-CHAT
GITHUB_BRANCH=main
